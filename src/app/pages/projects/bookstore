import sqlite3
from urllib.parse import parse_qs

DB_PATH = "/home/sujit1122/books.db"


def init_db():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS Books (
            title TEXT,
            author TEXT,
            year TEXT,
            isbn TEXT,
            publisher TEXT
        )
    """)
    conn.commit()
    conn.close()


def get_all_books():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM Books")
    rows = cursor.fetchall()
    conn.close()
    return rows


def search_books(environ):
    try:
        size = int(environ.get("CONTENT_LENGTH", 0))
    except:
        size = 0

    body = environ["wsgi.input"].read(size)
    params = parse_qs(body.decode())

    title = params.get("title", [""])[0]
    author = params.get("author", [""])[0]
    year = params.get("year", [""])[0]
    isbn = params.get("isbn", [""])[0]
    publisher = params.get("publisher", [""])[0]

    query = "SELECT * FROM Books WHERE 1=1"
    values = []

    if title:
        query += " AND title=?"
        values.append(title)

    if author:
        query += " AND author=?"
        values.append(author)

    if year:
        query += " AND year=?"
        values.append(year)

    if isbn:
        query += " AND isbn=?"
        values.append(isbn)

    if publisher:
        query += " AND publisher=?"
        values.append(publisher)

    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(query, values)
    results = cursor.fetchall()
    conn.close()

    output = "<h2>Search Results</h2>"
    output += '<a href="/">Back to Search</a><br><br>'

    if results:
        output += "<h3>Found " + str(len(results)) + " record(s)</h3>"
        for row in results:
            output += "<hr>"
            output += "<b>Title:</b> " + str(row[0]) + "<br>"
            output += "<b>Author:</b> " + str(row[1]) + "<br>"
            output += "<b>Year:</b> " + str(row[2]) + "<br>"
            output += "<b>ISBN:</b> " + str(row[3]) + "<br>"
            output += "<b>Publisher:</b> " + str(row[4]) + "<br>"
    else:
        output += "<h3>No records found</h3>"

    return output


def application(environ, start_response):
    init_db()
    path = environ.get("PATH_INFO", "/")

    if path == "/":
        content = """
        <h2>Search Books</h2>
        <form method="POST" action="/search">
            Title: <input type="text" name="title"><br><br>
            Author: <input type="text" name="author"><br><br>
            Year: <input type="text" name="year"><br><br>
            ISBN: <input type="text" name="isbn"><br><br>
            Publisher: <input type="text" name="publisher"><br><br>
            <input type="submit" value="Search">
        </form>
        <br>
        <a href="/view">View All Books</a>
        """

    elif path == "/search":
        content = search_books(environ)

    elif path == "/view":
        rows = get_all_books()
        content = "<h2>All Books</h2>"
        content += '<a href="/">Back to Search</a><br><br>'

        if rows:
            for row in rows:
                content += "<hr>"
                content += "<b>Title:</b> " + str(row[0]) + "<br>"
                content += "<b>Author:</b> " + str(row[1]) + "<br>"
                content += "<b>Year:</b> " + str(row[2]) + "<br>"
                content += "<b>ISBN:</b> " + str(row[3]) + "<br>"
                content += "<b>Publisher:</b> " + str(row[4]) + "<br>"
        else:
            content += "<p>No books in database.</p>"

    else:
        content = "<h3>Page Not Found</h3>"

    start_response("200 OK", [("Content-Type", "text/html")])
    return [content.encode("utf-8")]